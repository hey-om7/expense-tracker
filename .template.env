# Shared environment for backend and frontend.
# Copy to .env (gitignored) in the repository root and fill in values.
# On Render, set these in the service's Environment tab instead.
# Only VITE_-prefixed variables reach browser code, and they are baked in at BUILD time.
# Never put secrets in VITE_ variables.
#
# [required]  the server won't start, or a core feature breaks, without it
# [feature]   required only for the feature named
# [optional]  has a working default

# ─── Core ───
# [required] MongoDB connection string (e.g. MongoDB Atlas). MONGODB_URI is also accepted.
MONGO_URI=
# [optional] Port the server listens on. Render sets this automatically.
PORT=5001
# [required] At least 32 chars. Generate: openssl rand -hex 48
JWT_SECRET=
# [optional]
JWT_EXPIRES_IN=7d
# [required] Public URL of the app, no trailing slash. Used in password reset and Gmail links.
# Dev: http://localhost:5173   Prod: https://your-app.onrender.com
FRONTEND_URL=
# [optional] Comma-separated origins allowed to call the API cross-origin.
# Leave empty when the UI and API share one origin (npm run prod, Docker, Render, Vite proxy).
ALLOWED_ORIGINS=
# [optional] Number of reverse proxies in front of the app, used to find the real client IP
# for rate limiting. Default 1 (Render, Docker). Wrong values let clients dodge rate limits.
TRUST_PROXY=1

# ─── Google Sign-In ───
# [feature: Google login] OAuth "Web application" client ID from Google Cloud Console.
# Add your app URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# [feature: Google login] Same value as GOOGLE_CLIENT_ID, exposed to the browser.
VITE_GOOGLE_CLIENT_ID=

# ─── Outbound email (password reset, reminders) ───
# [feature: email] With Gmail, EMAIL_PASS must be an App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# [optional] Defaults to "Vestor" <noreply@vestor.app>
EMAIL_FROM=

# ─── Gmail statement scanning (per-user OAuth, read-only) ───
# [feature: Gmail scan] Requires the Gmail API enabled on the same OAuth client as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=
# [feature: Gmail scan] Must be on the same origin as the app, and listed as an
# "Authorized redirect URI" on the OAuth client.
# Dev: http://localhost:5173/api/gmail/oauth/callback
# Prod: https://your-app.onrender.com/api/gmail/oauth/callback
GMAIL_OAUTH_REDIRECT_URI=
# [feature: Gmail scan, AI keys] 64 hex chars; encrypts stored Gmail tokens and users' AI API keys.
# Generate: openssl rand -hex 32
# Changing it later disconnects every user's Gmail and makes saved AI keys unreadable.
# After first setting it, encrypt existing plaintext keys once: node backend/scripts/encrypt-api-keys.js
GMAIL_TOKEN_ENCRYPTION_KEY=
# [optional] Default true. Accepts secrets saved in the old unbound format (v1 and
# plaintext API keys). Run `node backend/scripts/encrypt-api-keys.js` until it reports
# all secrets are v2, then set this to false to reject old-format secrets permanently.
ALLOW_LEGACY_SECRETS=

# ─── AI (Groq) ───
# AI chat uses each user's own Groq key from Settings; no server key is needed for it.
# [optional] Server-wide Groq key for reading bank emails the regexes can't parse.
# If unset, each user's own Groq key from Settings is used.
GROQ_API_KEY=
# [optional] Both default to llama-3.1-8b-instant
GROQ_STATEMENT_MODEL=
GROQ_EMAIL_MODEL=

# ─── Development only ───
# Backend URL the Vite dev server proxies /api to (match PORT above), e.g. http://localhost:5001
VITE_API_PROXY_TARGET=
# [optional] Full API origin if the browser should call a different origin.
# Leave empty for same-origin. If set, add the frontend origin to ALLOWED_ORIGINS.
VITE_API_URL=
