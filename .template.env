# Shared environment for backend and frontend.
# Copy to .env (gitignored) in the repository root and fill in values.
# Only VITE_-prefixed variables are exposed to browser code. Never put secrets in VITE_ variables.

# ─── Backend ───
MONGO_URI=
PORT=5001
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty when using the Vite dev proxy or nginx (same-origin).
ALLOWED_ORIGINS=
# Public URL of the frontend, used to build password reset links in emails (e.g. http://localhost:5173).
FRONTEND_URL=

# Gemini AI
GEMINI_API_KEY=

# ─── Email — Outbound SMTP (sending notifications & summaries) ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── Gmail — Per-user statement scanning (Google OAuth, read-only) ───
# Users connect their own Gmail from the Bills tab. Requires the Gmail API enabled
# and an OAuth "Web application" client in Google Cloud Console (same client as GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_SECRET=
# Must go through the SAME origin as the frontend (Vite proxy / nginx), e.g.
# http://localhost:5173/api/gmail/oauth/callback — and be listed as an
# "Authorized redirect URI" on the OAuth client.
GMAIL_OAUTH_REDIRECT_URI=
# 64 hex chars; encrypts stored Gmail refresh tokens. Generate: openssl rand -hex 32
# Changing it later disconnects every user's Gmail.
GMAIL_TOKEN_ENCRYPTION_KEY=

# ─── Gmail — Legacy shared inbox (IMAP) — no longer used by the app ───
GMAIL_INBOX_USER=
GMAIL_INBOX_PASS=

# ─── Frontend (Vite) ───
# Dev only: backend URL that the Vite dev server proxies /api to (use the PORT above).
VITE_API_PROXY_TARGET=

# Optional: full API origin for the browser to call directly (cross-origin).
# Leave unset to use relative /api (Vite proxy in dev, nginx in production).
# If set, the frontend origin must be listed in ALLOWED_ORIGINS.
VITE_API_URL=
