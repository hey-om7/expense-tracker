# Shared environment for backend and frontend.
# Copy to .env (gitignored) in the repository root and fill in values.
# Only VITE_-prefixed variables are exposed to browser code. Never put secrets in VITE_ variables.

# ─── Backend ───
MONGO_URI=
PORT=5001
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty when using the Vite dev proxy or nginx (same-origin).
ALLOWED_ORIGINS=

# Gemini AI
GEMINI_API_KEY=

# ─── Email — Outbound SMTP (sending notifications & summaries) ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── Gmail — Inbound IMAP (reading inbox for CC bill detection) ───
# Can be a different Gmail account from the one used for sending above.
# Must have IMAP enabled and use an App Password (not the account password).
GMAIL_INBOX_USER=
GMAIL_INBOX_PASS=

# ─── Frontend (Vite) ───
# Dev only: backend URL that the Vite dev server proxies /api to (use the PORT above).
VITE_API_PROXY_TARGET=

# Optional: full API origin for the browser to call directly (cross-origin).
# Leave unset to use relative /api (Vite proxy in dev, nginx in production).
# If set, the frontend origin must be listed in ALLOWED_ORIGINS.
VITE_API_URL=
